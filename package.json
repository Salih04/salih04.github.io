{
  "name": "s-lab-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "S//LAB — Salih Research Lab. An interactive research portfolio with a lab mode and a case study mode.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:boundary && next build && node scripts/public-boundary.mjs out",
    "start": "npx --yes serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundary": "node scripts/public-boundary.mjs src",
    "check": "npm run typecheck && npm run test && npm run check:boundary"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
